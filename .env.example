# DataSnake Seismic Intelligence — environment configuration
# Copy to .env for local use ONLY (e.g. running a notebook by hand for a
# one-off check). Normal operation never needs this file: the pipeline runs
# via .github/workflows/pipeline.yml and the API deploys via Railway, both
# reading these same values from their own secret stores, not from a local
# .env. See docs/MODULE2_ARCHITECTURE.md.

# ── Supabase (terrawatchapp's project) ──────────────────────────────────────
# Use the TRANSACTION POOLER connection (port 6543) — the direct host
# (port 5432) resolves IPv6-only and won't work from most CI runners or
# restricted networks. Dashboard → Connect → Transaction pooler tab.
DATABASE_URL=postgresql://postgres.YOURREF:YOURPASSWORD@aws-<n>-<region>.pooler.supabase.com:6543/postgres
DATABASE_POOLER_URL=postgresql://postgres.YOURREF:YOURPASSWORD@aws-<n>-<region>.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://YOURREF.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key

# ── API service auth (Phase 1: single static token) ─────────────────────────
MODULE2_API_TOKEN=choose_a_long_random_value

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/module2_pipeline.log
